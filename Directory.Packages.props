<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Match the submodule's pins so shared transitive graphs resolve identically. -->
    <PackageVersion Include="FSharp.Core" Version="10.1.201" />
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.5" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageVersion Include="Microsoft.ML" Version="4.0.0" />
    <PackageVersion Include="Microsoft.ML.FastTree" Version="4.0.0" />
    <PackageVersion Include="NAudio.Core" Version="2.2.1" />
    <PackageVersion Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="BunLabs.NAudio.Flac" Version="2.0.1" />
    <PackageVersion Include="SimpleSIMD" Version="4.6.0" />

    <!-- Deliberate divergence from the submodule: AnyCPU ships osx-arm64 natives, x64 does not. -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />

    <!-- StringSmith's own dependencies. -->
    <PackageVersion Include="AlphaTab" Version="1.8.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageVersion Include="Avalonia.FuncUI" Version="1.5.2" />
    <PackageVersion Include="Avalonia.FuncUI.Elmish" Version="1.5.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageVersion Include="Elmish" Version="5.0.2" />
    <!-- Transitive via Avalonia.FreeDesktop; 0.21.2 carries GHSA-xrw6-gwf8-vvr9. Pinned directly. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.95.1" />

    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="Expecto" Version="10.2.3" />
    <PackageVersion Include="Expecto.FsCheck" Version="10.2.3" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
  </ItemGroup>
</Project>
