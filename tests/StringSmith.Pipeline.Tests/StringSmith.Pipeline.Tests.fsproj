<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The acceptance round trip from the brief, headless: a real Guitar Pro file in, _p and
    _m PSARCs out, TOC read back, SNG decrypted with each platform's key and compared to
    the notes that were packed. WEM encoding needs Wwise, which is not here, so the MIT
    WEM fixtures from iminashi's integration tests stand in (referenced in place).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Fixtures.fs" />
    <Compile Include="BinaryPrimitiveTests.fs" />
    <Compile Include="RoundTripTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/StringSmith.Core/StringSmith.Core.fsproj" />
    <ProjectReference Include="../../src/StringSmith.Sync/StringSmith.Sync.fsproj" />
    <ProjectReference Include="../../src/StringSmith.Conversion/StringSmith.Conversion.fsproj" />
    <ProjectReference Include="../../src/StringSmith.GuitarPro/StringSmith.GuitarPro.fsproj" />
    <ProjectReference Include="../../src/StringSmith.Pipeline/StringSmith.Pipeline.fsproj" />
    <ProjectReference Include="$(RocksmithNetRoot)src/Rocksmith2014.Common/Rocksmith2014.Common.fsproj" />
    <ProjectReference Include="$(RocksmithNetRoot)src/Rocksmith2014.DD/Rocksmith2014.DD.fsproj" />
    <ProjectReference Include="$(RocksmithNetRoot)src/Rocksmith2014.PSARC/Rocksmith2014.PSARC.fsproj" />
    <ProjectReference Include="$(RocksmithNetRoot)src/Rocksmith2014.SNG/Rocksmith2014.SNG.fsproj" />
    <ProjectReference Include="$(RocksmithNetRoot)src/Rocksmith2014.XML/Rocksmith2014.XML.csproj" />
    <ProjectReference Include="$(RocksmithNetRoot)src/Rocksmith2014.Audio/Rocksmith2014.Audio.fsproj" />
  </ItemGroup>
</Project>
