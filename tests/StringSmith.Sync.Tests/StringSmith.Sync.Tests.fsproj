  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Expecto.FsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/StringSmith.Core/StringSmith.Core.fsproj" />
    <ProjectReference Include="../../src/StringSmith.Sync/StringSmith.Sync.fsproj" />
  </ItemGroup>
</Project>
